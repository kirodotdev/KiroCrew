                }
              }
            }
          },
          "builtIn": true,
          "description": "Full feature pipeline in the given workdir: requirements, reviewed design loop, plan, implement-and-review loop with two-model review, fail-closed validation gate. Heavy; for hard multi-file tasks.",
          "inputs": {
            "task": "prompt",
            "workdir": "string"
          },
          "name": "feature-pipeline",
          "plan": [
            {
              "agentName": "wf-coder",
              "effortLevel": "low",
              "nodeId": "setup",
              "type": "step"
            },
            {
              "agentName": "wf-design",
              "nodeId": "requirements",
              "type": "step"
            },
            {
              "maxIterations": 2,
              "nodeId": "design-loop",
              "onMaxIterations": "pause",
              "steps": [
                {
                  "agentName": "wf-design",
                  "nodeId": "design-draft",
                  "type": "step"
                },
                {
                  "agentName": "wf-design-reviewer",
                  "nodeId": "design-review",
                  "type": "step"
                }
              ],
              "stopCondition": {
                "fileCheck": {
                  "jsonPath": "verdict",
                  "path": "{{setup.output}}/design-review.json",
                  "value": "APPROVED"
                }
              },
              "type": "repeat"
            },
            {
              "agentName": "wf-planner",
              "effortLevel": "high",
              "nodeId": "plan",
              "type": "step"
            },
            {
              "maxIterations": 2,
              "nodeId": "code-loop",
              "onMaxIterations": "pause",
              "steps": [
                {
                  "agentName": "wf-coder",
                  "nodeId": "implement",
                  "type": "step"
                },
                {
                  "branches": [
                    {
                      "agentName": "semantic_reviewer",
                      "effortLevel": "xhigh",
                      "modelId": "claude-fable-5",
                      "nodeId": "review-fable",
                      "type": "step"
                    },
                    {
                      "agentName": "semantic_reviewer",
                      "effortLevel": "xhigh",
                      "modelId": "gpt-5.6-sol",
                      "nodeId": "review-gpt",
                      "type": "step"
                    }
                  ],
                  "nodeId": "code-reviews",
                  "type": "parallel"
                },
                {
                  "agentName": "wf-review-aggregator",
                  "effortLevel": "high",
                  "nodeId": "code-aggregate",
                  "type": "step"
                }
              ],
              "stopCondition": {
                "fileCheck": {
                  "jsonPath": "verdict",
                  "path": "{{setup.output}}/code-review.json",
                  "value": "APPROVED"
                }
              },
              "type": "repeat"
            },
            {
              "maxIterations": 1,
              "nodeId": "validate-gate",
              "onMaxIterations": "abort",
              "steps": [
                {
                  "agentName": "wf-coder",
                  "nodeId": "validate",
                  "type": "step"
                }
              ],
              "stopCondition": {
                "fileCheck": {
                  "jsonPath": "verdict",
                  "path": "{{setup.output}}/validation.json",
                  "value": "PASS"
                }
              },
              "type": "repeat"
            }
          ],
          "source": "bundled://feature-pipeline"
        },
