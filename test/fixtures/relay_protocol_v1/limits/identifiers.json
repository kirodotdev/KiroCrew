{
  "fixture": "limits/identifiers",
  "kind": "limits",
  "contract": "Kiro Relay protocol v1",
  "contractFile": "rc-relay-protocol-v1.md",
  "protocolVersion": 1,
  "section": "3",
  "status": "provisional",
  "summary": "Grammar and length of every identifier on the wire.",
  "provisional": [
    {
      "field": "Kiro user ID grammar",
      "why": "The format of a Kiro user ID is not verified. The backend team confirms it."
    },
    {
      "field": "endpointId grammar and derivation",
      "why": "The derivation inputs and the label's length come from the backend team."
    }
  ],
  "planPosition": [
    "Every pattern here. Tunnels' caller field took only lower-case usernames up to 64 characters."
  ],
  "identifiers": {
    "kiroUserId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+=/-]{0,255}$",
      "maxLength": 256,
      "why": "Wide enough for unknown ID formats, and safe as a header value: no spaces, commas, semicolons, quotes or control characters.",
      "valid": [
        "u-0001.example-owner",
        "u-0002.example-teammate",
        "d-9067642ac7.4f1e2d3c-0000-4abc-9def-0123456789ab"
      ],
      "invalid": [
        "",
        " owner",
        "owner@example.com, admin",
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "xé"
      ]
    },
    "crewIdentity": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+=/-]{0,255}$",
      "maxLength": 256,
      "valid": [
        "crew-identity.example-0001"
      ]
    },
    "endpointId": {
      "pattern": "^[a-z0-9]{20,63}$",
      "why": "A DNS label from a keyed hash.",
      "valid": [
        "k7qm3x2vtzr4hbn6cwapfe5dj3",
        "t4nw2q7hzk5rmc3xvbp6ld2fe7"
      ],
      "invalid": [
        "short",
        "Upper-case-not-allowed-here",
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ]
    },
    "crewInstanceId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "valid": [
        "3f2b8c1e-7a4d-4e9b-9c61-2d5a8f0e4b17",
        "9d0c4e2a-1b7f-4a63-8e25-6f3b1c9d7a02"
      ]
    },
    "region": {
      "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+$",
      "valid": [
        "us-east-1",
        "eu-central-1"
      ]
    },
    "jti": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "streamId": {
      "type": "integer",
      "min": 0,
      "max": 9007199254740991
    },
    "displayName": {
      "minLength": 1,
      "maxLength": 128
    },
    "crewVersion": {
      "maxLength": 32
    }
  }
}
