{
  "fixture": "frames/ws-close",
  "kind": "frame",
  "contract": "Kiro Relay protocol v1",
  "contractFile": "rc-relay-protocol-v1.md",
  "protocolVersion": 1,
  "section": "5.3",
  "status": "decided",
  "summary": "Closes one proxied WebSocket, with an optional code and reason.",
  "provisional": [],
  "planPosition": [
    "The relay rewrites a Crew close code in 4400 to 4499 to 1011."
  ],
  "frame": "ws-close",
  "leg": "host",
  "direction": "both",
  "encoding": "One JSON object per WebSocket text frame, UTF-8. Unknown fields are ignored by the receiver.",
  "fields": {
    "type": {
      "type": "string",
      "required": true,
      "notes": "Always \"ws-close\"."
    },
    "id": {
      "type": "integer",
      "required": true,
      "notes": "The WebSocket's stream id."
    },
    "code": {
      "type": "integer",
      "required": false,
      "notes": "1000, or 3000 to 4999. The relay's own block, 4400 to 4499, is never used by the Crew."
    },
    "reason": {
      "type": "string",
      "required": false,
      "notes": "At most 123 bytes."
    }
  },
  "valid": [
    {
