    "type": {
      "type": "string",
      "required": true,
      "notes": "Always \"ws-upgrade\"."
    },
    "id": {
      "type": "integer",
      "required": true,
      "notes": "Stream id, from the same counter as requests."
    },
    "path": {
      "type": "string",
      "required": true,
      "notes": "Starts with /."
    },
    "query": {
      "type": "string",
      "required": true,
      "notes": "Without the leading ?, or empty."
    },
    "protocols": {
      "type": "string",
      "required": false,
      "notes": "The Sec-WebSocket-Protocol value the viewer asked for."
    },
    "headers": {
      "type": "array of [name, value]",
      "required": false,
      "notes": "Filtered headers as pairs, at most 64, names at most 256 and values at most 8192 characters. Upgrade, Connection and Sec-WebSocket-* are not included."
    },
    "user": {
      "type": "string",
      "required": true,
      "notes": "The verified caller's Kiro user ID."
    }
  },
