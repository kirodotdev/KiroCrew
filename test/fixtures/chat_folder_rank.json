  "sort_cases": [
    {
      "name": "ranked rows sort before unranked, by rank",
      "rows": [
        {
          "id": "u0",
          "name": "a",
          "order": 0
        },
        {
          "id": "r1",
          "name": "z",
          "rank": "k"
        },
        {
          "id": "r0",
          "name": "y",
          "rank": "F"
        }
      ],
      "expected": [
        "r0",
        "r1",
        "u0"
      ]
    },
    {
      "name": "equal ranks break by id, not name",
      "rows": [
        {
          "id": "b",
          "name": "a",
          "rank": "V"
        },
        {
          "id": "a",
          "name": "z",
          "rank": "V"
        }
      ],
      "expected": [
        "a",
        "b"
      ]
    },
    {
      "name": "equal ranks break by UTF-16 id order",
      "rows": [
        {
          "id": "\ud83d\ude00",
          "name": "a",
          "rank": "V"
        },
        {
          "id": "\uffff",
          "name": "z",
          "rank": "V"
        }
      ],
      "expected": [
        "\ud83d\ude00",
        "\uffff"
      ]
    },
    {
      "name": "a corrupt rank reads as unranked",
      "rows": [
        {
          "id": "t0",
          "name": "x",
          "rank": "a0",
          "order": 0
        },
        {
          "id": "t1",
          "name": "x",
          "rank": 5,
          "order": 1
        },
        {
          "id": "t2",
          "name": "x",
          "rank": "",
          "order": 2
        },
        {
          "id": "t3",
          "name": "x",
          "rank": "a b",
          "order": 3
        },
        {
          "id": "ok",
          "name": "x",
          "rank": "zz"
        }
      ],
      "expected": [
        "ok",
        "t0",
        "t1",
        "t2",
        "t3"
      ]
    },
    {
      "name": "shorter rank is a smaller fraction",
      "rows": [
        {
          "id": "long",
          "name": "a",
          "rank": "V1"
        },
        {
          "id": "short",
          "name": "b",
          "rank": "V"
        },
        {
          "id": "zero",
          "name": "c",
          "rank": "U"
        }
      ],
      "expected": [
        "zero",
        "short",
        "long"
      ]
    },
    {
      "name": "digits sort before capitals before lowercase",
      "rows": [
        {
          "id": "lower",
          "name": "a",
          "rank": "a"
        },
        {
          "id": "upper",
          "name": "b",
          "rank": "A"
        },
        {
          "id": "digit",
          "name": "c",
          "rank": "9"
        }
      ],
      "expected": [
        "digit",
        "upper",
        "lower"
      ]
    }
  ]
