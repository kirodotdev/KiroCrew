{
  "claude": {
    "argv": [
      "/opt/bin/node",
      "/opt/lib/claude-agent-acp/index.js"
    ],
    "env_added": {
      "KIROCREW_RUNTIME_PYTHON": "<interpreter>",
      "KIROCREW_SESSION_KEY": "golden-session",
      "KIROCREW_SPAWNED": "1",
      "KIROCREW_STUB_SESSION_TOKEN": "<session-token>",
      "PATH": "<augmented-path>"
    },
    "spawn_label": "claude-agent-acp via /opt/lib/claude-agent-acp/index.js",
    "stderr_label": "claude-acp via /opt/lib/claude-agent-acp/index.js"
  },
  "codex": {
    "argv": [
      "/opt/bin/node",
