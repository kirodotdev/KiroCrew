    "spawn_label": "opencode acp",
    "stderr_label": "opencode"
  },
  "pi": {
    "argv": [
      "/opt/bin/node",
      "/opt/lib/pi-acp/index.js"
    ],
    "env_added": {
      "KIROCREW_PI_GATE_SESSION": "<nonce>",
      "KIROCREW_RUNTIME_PYTHON": "<interpreter>",
      "KIROCREW_SESSION_KEY": "golden-session",
      "KIROCREW_SPAWNED": "1",
      "KIROCREW_STUB_SESSION_TOKEN": "<session-token>",
      "PATH": "<augmented-path>",
      "PI_ACP_PI_COMMAND": "/opt/run/pi-launcher.sh"
    },
    "spawn_label": "pi-acp via /opt/lib/pi-acp/index.js",
    "stderr_label": "pi-acp via /opt/lib/pi-acp/index.js"
  }
