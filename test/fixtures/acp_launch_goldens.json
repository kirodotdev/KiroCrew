{
  "claude": {
    "argv": [
      "/opt/bin/node",
      "/opt/lib/claude-agent-acp/index.js"
    ],
    "env_added": {
      "KIROCREW_RUNTIME_PYTHON": "<interpreter>",
      "KIROCREW_SESSION_KEY": "golden-session",
      "KIROCREW_SPAWNED": "1",
      "KIROCREW_STUB_SESSION_TOKEN": "<session-token>",
      "PATH": "<augmented-path>"
    },
    "spawn_label": "claude-agent-acp via /opt/lib/claude-agent-acp/index.js",
    "stderr_label": "claude-acp via /opt/lib/claude-agent-acp/index.js"
  },
  "codex": {
    "argv": [
      "/opt/bin/node",
      "/opt/lib/codex-acp/index.js"
    ],
    "env_added": {
      "KIROCREW_RUNTIME_PYTHON": "<interpreter>",
      "KIROCREW_SPAWNED": "1",
      "KIROCREW_SPAWN_INSTANCE": "<spawn-instance>",
      "PATH": "<augmented-path>"
    },
    "env_removed": [],
    "served_by": "AcpRuntime"
  },
  "custom": {
    "argv": [
      "/opt/bin/my-agent",
      "--acp",
      " a b "
    ],
    "env_added": {
      "KIROCREW_RUNTIME_PYTHON": "<interpreter>",
      "KIROCREW_SESSION_KEY": "golden-session",
      "KIROCREW_SPAWNED": "1",
      "KIROCREW_STUB_SESSION_TOKEN": "<session-token>",
      "PATH": "<augmented-path>"
    },
    "spawn_label": "Custom ACP",
    "stderr_label": "Custom ACP"
  },
  "deepseek": {
    "argv": [
      "/opt/bin/dsh",
      "--profile",
      "acp",
      "--patch",
      "/opt/run/kiro_crew_dsh_gate.patch.yml"
    ],
    "env_added": {
      "DSH_PERMISSION_MODE": "workspace-write",
      "KIROCREW_DSH_GATE_SESSION": "<nonce>",
      "KIROCREW_RUNTIME_PYTHON": "<interpreter>",
      "KIROCREW_SCRATCH": "<scratch>",
      "KIROCREW_SESSION_KEY": "golden-session",
      "KIROCREW_SPAWNED": "1",
      "KIROCREW_STUB_SESSION_TOKEN": "<session-token>",
      "KIRO_CHAT_LOG_FILE": "<scratch-log>",
      "PATH": "<augmented-path>",
      "TEMP": "<scratch>",
      "TMP": "<scratch>",
      "TMPDIR": "<scratch>"
    },
    "spawn_label": "/opt/bin/dsh --profile acp --patch /opt/run/kiro_crew_dsh_gate.patch.yml",
    "stderr_label": "/opt/bin/dsh --profile acp --patch /opt/run/kiro_crew_dsh_gate.patch.yml"
  },
  "goose": {
    "argv": [
      "/opt/bin/goose",
      "acp",
      "--with-builtin",
      "developer"
    ],
    "env_added": {
      "GOOSE_MODE": "approve",
      "KIROCREW_RUNTIME_PYTHON": "<interpreter>",
      "KIROCREW_SESSION_KEY": "golden-session",
      "KIROCREW_SPAWNED": "1",
      "KIROCREW_STUB_SESSION_TOKEN": "<session-token>",
      "PATH": "<augmented-path>"
    },
    "spawn_label": "goose acp",
    "stderr_label": "goose"
  },
  "kas": {
    "argv": [
      "/opt/bin/kiro-cli",
      "acp",
