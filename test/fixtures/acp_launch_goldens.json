      "kirocrew-skill-view-golden"
    ],
    "env_added": {
      "KIROCREW_RUNTIME_PYTHON": "<interpreter>",
      "KIROCREW_SESSION_KEY": "golden-session",
      "KIROCREW_SPAWNED": "1",
      "KIROCREW_STUB_SESSION_TOKEN": "<session-token>",
      "PATH": "<augmented-path>"
    },
    "spawn_label": "kiro-cli acp",
    "stderr_label": "kiro-cli"
  },
  "kiro": {
    "argv": [
      "/opt/bin/kiro-cli",
      "acp",
      "--agent",
      "kirocrew-skill-view-golden"
    ],
    "env_added": {
      "KIROCREW_RUNTIME_PYTHON": "<interpreter>",
      "KIROCREW_SESSION_KEY": "golden-session",
      "KIROCREW_SPAWNED": "1",
      "KIROCREW_STUB_SESSION_TOKEN": "<session-token>",
      "PATH": "<augmented-path>"
    },
    "spawn_label": "kiro-cli acp",
    "stderr_label": "kiro-cli"
  },
  "opencode": {
    "argv": [
      "/opt/bin/opencode",
      "acp"
    ],
    "env_added": {
      "KIROCREW_RUNTIME_PYTHON": "<interpreter>",
      "KIROCREW_SESSION_KEY": "golden-session",
      "KIROCREW_SPAWNED": "1",
      "KIROCREW_STUB_SESSION_TOKEN": "<session-token>",
      "OPENCODE_CONFIG_CONTENT": "{\"permission\":\"ask\"}",
      "PATH": "<augmented-path>"
