# Byte-compiled / optimized / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# Build / packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Runtime data generated by the app (never commit)
data/
*.log
activation.json
.app_secret
audit/
telemetry/
sessions/

# Local credentials / real provider configs (keep only *.example.json)
config/providers.json
config/native_tools.json
*.key
*.pem
.env
.env.*

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
