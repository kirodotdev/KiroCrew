#!/bin/sh
# KiroCrew CLI wrapper.
#
# Public/OSS build: delegates to the bundled .venv so child processes inherit
# a working Python even under a minimal PATH (e.g. MCP servers spawned by the
# agent backend).

# Resolve symlinks so SCRIPT_DIR always points into the real install dir,
# even when invoked via ~/.local/bin/kirocrew symlink.
REAL_PATH="$(readlink -f "$0" 2>/dev/null || python3 -c "import os,sys;print(os.path.realpath(sys.argv[1]))" "$0" 2>/dev/null)"
if [ -z "$REAL_PATH" ]; then
    echo "❌ Unable to resolve real path of $0. Install python3 or GNU coreutils." >&2
    exit 1
fi
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")/.." && pwd)"
export KIROCREW_PROJECT_DIR="${KIROCREW_PROJECT_DIR:-$SCRIPT_DIR}"

# Standard install: run via the bundled venv.
if [ -x "$SCRIPT_DIR/.venv/bin/kirocrew" ]; then
    exec "$SCRIPT_DIR/.venv/bin/kirocrew" "$@"
fi

# No venv found. The OSS build runs entirely from a pip venv created by
# install.sh / setup.sh / minimal_install.sh, so this is almost always a
# missing or incomplete install rather than a Brazil workspace.
echo "❌ KiroCrew venv not found at $SCRIPT_DIR/.venv" >&2
echo "   The OSS build runs from a Python venv — set one up with:" >&2
echo "       cd $SCRIPT_DIR && bash minimal_install.sh" >&2
echo "   (brazil not found — Brazil workspaces are not used in the OSS build)" >&2
exit 1
