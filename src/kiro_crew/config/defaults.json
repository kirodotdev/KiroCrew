{
  "name": "kirocrew",
  "description": "Autonomous personal AI agent — schedules recurring tasks, spawns parallel workers, learns from corrections, and operates independently via Slack",
  "model": "claude-opus-4.8",
  "tools": [
    "execute_bash",
    "fs_read",
    "fs_write",
    "code",
    "grep",
    "glob",
    "web_fetch",
    "web_search",
    "introspect",
    "session",
    "report",
    "tool_search",
    "@kirocrew-cron",
    "@kirocrew-core",
    "@kirocrew-computer"
  ],
  "allowedTools": [
    "fs_read",
    "code",
    "glob",
    "grep",
    "web_fetch",
    "web_search",
    "introspect",
    "session",
    "report",
    "@kirocrew-cron/cron_list",
    "@kirocrew-cron/cron_pause",
    "@kirocrew-cron/cron_resume",
    "@kirocrew-cron/cron_trigger",
    "@kirocrew-cron/cron_remove",
    "@kirocrew-cron/cron_remove_all",
    "@kirocrew-core"
  ],
  "resources": [
    "file://.kiro/steering/**/*.md"
  ],
  "includeMcpJson": false,
  "hooks": {
    "auto_approve_tools": [
      "kirocrew browse *",
      "*kirocrew browse *"
    ],
    "postToolUse": [
      {
        "matcher": "execute_bash",
        "command": "{ echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) BASH:\"; cat; echo; } >> \"${KIROCREW_HOME:-$HOME/.kiro/crew}/audit.log\""
      }
    ]
  }
}
