{
  "id": "goal-board",
  "version": 1,
  "title": "Goal board",
  "description": "The work ledger this crewmate conducts: the goal, the round it is on, and every item with its state, the conductor's decision, the acceptance verdict and the worker's own last report. Read from the work slot fold, so an item's state here is the state the conductor recorded.",
  "source": "builtin",
  "fields": {
    "goal": { "type": "string", "source": { "fold": "work", "path": "conductor.goal" } },
    "round": { "type": "number", "source": { "fold": "work", "path": "conductor.round" } },
    "goal_version": { "type": "number", "source": { "fold": "work", "path": "conductor.goal_version" } },
    "depth": { "type": "number", "source": { "fold": "work", "path": "conductor.depth" } },
    "created_at": { "type": "string", "source": { "fold": "work", "path": "conductor.created_at" } },
    "last_entry_at": { "type": "string", "source": { "fold": "work", "path": "conductor.last_entry_at" } },
    "entries": { "type": "number", "source": { "fold": "work", "path": "conductor.entries" } },
    "items": { "type": "array", "source": { "fold": "work", "path": "items" } },
    "omitted": { "type": "number", "source": { "fold": "work", "path": "omitted" } }
  }
}
