{
  "name": "kirocrew",
  "base_branch": "main",
  "single_commit": true,
  "gates": [
    "python -m pytest -q",
    "isort --check-only src/kiro_crew test",
    "flake8 src/kiro_crew test",
    "mypy src/kiro_crew/",
    "npm --prefix website run build",
    "npm --prefix website test"
  ],
  "rule_files": [
    "AUTOSDE.yaml",
    "website/AUTOSDE.yaml",
    "AGENTS.md",
    "website/AGENTS.md"
  ],
  "reviewers": [
    {
      "name": "gpt",
      "model": "gpt-5.6-sol",
      "model_tier": "gpt-5.x",
      "contract": ".github/workflows/codex-review.yml",
      "rubric": null
    },
    {
      "name": "opus",
      "model": "claude-opus-5",
      "model_tier": "claude-opus-4.8",
      "contract": ".github/workflows/claude-review.yml",
      "rubric": null
    }
  ],
  "readiness": {
    "status_context": "PR Readiness",
    "defer_label": null
  }
}
