    {"id": "brand-name", "cmd": ["{py}", "scripts/check_brand_name.py"], "self_test": true, "base_env": "BRAND_BASE_REF", "ci": {"file": "fast-gate.yml", "text": "scripts/check_brand_name.py"}},
