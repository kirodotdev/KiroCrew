{
  "_comment": "Gates pre_push_gate.py runs for kirodotdev/KiroCrew. Each gate names the CI file and the exact text of the CI step it mirrors (test_gate_map_covers_ci.py pins both). Every gate runs on every diff, because a path filter that misses one input gives a false green proof. Only a gate that took more than about 10 s when measured carries a 'slow' note and a 'paths' filter, and that filter is the gate's real inputs (its sources, its tool config, its baseline files), which a test reads back from the gate's script. 'base_env' receives the merge-base sha. 'self_test': true runs cmd + --test first. Frontend gates need website/node_modules and stay in ci_only.",
  "gates": [
    {"id": "black", "cmd": ["{py}", "scripts/check_black_formatting.py"], "module": "black", "ci": {"file": "ci.yml", "text": "scripts/check_black_formatting.py"}},
    {"id": "isort", "cmd": ["{py}", "-m", "isort", "--check-only", "src/kiro_crew", "test", "conftest.py", "xdist_budget.py"], "module": "isort", "paths": ["^(src/kiro_crew|test)/", "^(conftest|xdist_budget)\\.py$", "^(pyproject\\.toml|setup\\.cfg)$"], "slow": "30.6 s", "ci": {"file": "ci.yml", "text": "isort --check-only src/kiro_crew test conftest.py xdist_budget.py"}},
    {"id": "flake8", "cmd": ["{py}", "-m", "flake8", "src/kiro_crew", "test", "conftest.py", "xdist_budget.py"], "module": "flake8", "paths": ["^(src/kiro_crew|test)/", "^(conftest|xdist_budget)\\.py$", "^(pyproject\\.toml|setup\\.cfg)$"], "slow": "34.4 s", "ci": {"file": "ci.yml", "text": "flake8 src/kiro_crew test conftest.py xdist_budget.py"}},
    {"id": "mypy", "cmd": ["{py}", "-m", "mypy", "src/kiro_crew/"], "module": "mypy", "paths": ["^src/kiro_crew/", "^(pyproject\\.toml|setup\\.cfg)$"], "slow": "3.0 s warm cache; ci.yml times a cold run at about 3 min", "ci": {"file": "ci.yml", "text": "mypy src/kiro_crew/"}},
    {"id": "subprocess-encoding", "cmd": ["{py}", "scripts/check_subprocess_encoding.py"], "self_test": true, "paths": ["^(src|scripts|test|packages|docker|packaging)/", "^(conftest|xdist_budget|setup)\\.py$", "^\\.github/subprocess-encoding-baseline\\.txt$"], "slow": "70.4 s", "ci": {"file": "ci.yml", "text": "scripts/check_subprocess_encoding.py"}},
    {"id": "acp-frame-host-data", "cmd": ["{py}", "scripts/check_acp_frame_host_data.py"], "ci": {"file": "ci.yml", "text": "scripts/check_acp_frame_host_data.py"}},
    {"id": "agent-sdk-boundary", "cmd": ["{py}", "scripts/check_agent_sdk_boundary.py"], "self_test": true, "paths": ["^src/", "^\\.github/agent-sdk-boundary-baseline\\.txt$", "^scripts/(check_agent_sdk_boundary|ratchet_scope)\\.py$"], "slow": "19.3 s", "ci": {"file": "ci.yml", "text": "scripts/check_agent_sdk_boundary.py"}},
    {"id": "sync-io-in-async", "cmd": ["{py}", "scripts/check_sync_io_in_async.py"], "self_test": true, "paths": ["^src/", "^\\.github/sync-io-in-async(-fs)?-baseline\\.txt$", "^scripts/(check_sync_io_in_async|ratchet_scope)\\.py$"], "slow": "20.7 s", "ci": {"file": "ci.yml", "text": "scripts/check_sync_io_in_async.py"}},
    {"id": "file-line-cap", "cmd": ["{py}", "scripts/check_file_line_cap.py"], "self_test": true, "ci": {"file": "ci.yml", "text": "scripts/check_file_line_cap.py"}},
    {"id": "lockdown-before-publish", "cmd": ["{py}", "scripts/check_lockdown_before_publish.py"], "ci": {"file": "ci.yml", "text": "scripts/check_lockdown_before_publish.py"}},
