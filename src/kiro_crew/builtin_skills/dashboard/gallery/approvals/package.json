{
  "bound_to": "crewmate:example",
  "kind": "dashboard",
  "model": {
    "types": {
      "decided": {
        "description": "how many approvals the crewmate's current session has had answered",
        "label": "Answered",
        "source": {
          "fold": "approvals",
          "path": "decided"
        },
        "type": "number"
      },
      "pending": {
        "description": "how many approvals wait on a person right now",
        "label": "Waiting",
        "source": {
          "fold": "approvals",
          "path": "pending"
        },
        "type": "number"
      },
      "pending_requests": {
        "description": "the approvals still waiting, oldest first, each with its id, tool and reason",
        "label": "Waiting now",
        "source": {
          "fold": "approvals",
          "path": "pending_requests"
        },
        "type": "array"
      },
      "requested": {
        "description": "how many approvals the crewmate's current session has asked for",
        "label": "Asked",
        "source": {
          "fold": "approvals",
          "path": "requested"
        },
        "type": "number"
      }
    }
  },
  "theme": {
    "tokens": {}
  },
  "view": {
    "html": "<section class=\"approvals\" id=\"approvals\">\n  <h1>Approvals</h1>\n  <div class=\"counts\">\n    <p class=\"count lit\"><span class=\"n\" id=\"pending\" data-dashboard-field=\"pending\">&mdash;</span> <span class=\"what\">waiting on you</span></p>\n    <p class=\"count\"><span class=\"n\" id=\"requested\" data-dashboard-field=\"requested\">&mdash;</span> <span class=\"what\">asked</span></p>\n    <p class=\"count\"><span class=\"n\" id=\"decided\" data-dashboard-field=\"decided\">&mdash;</span> <span class=\"what\">answered</span></p>\n  </div>\n  <div id=\"waiting\" hidden>\n    <ol id=\"asks\" class=\"asks\" aria-label=\"Waiting on you\"></ol>\n    <p id=\"none\" class=\"none\" hidden>Nothing right now</p>\n  </div>\n  <noscript>\n    <p class=\"notice\">Your administrator's network policy has turned scripts off for this page, so the list of what waits on you is not drawn. Ask whoever administers this crew's network policy to allow scripts on this page.</p>\n  </noscript>\n</section>\n<style>\n  .approvals { max-width: 720px; }\n  .approvals h1 { margin: 0 0 12px; font-size: 1.15em; font-weight: 600; color: var(--text-strong); }\n  .counts { display: flex; flex-wrap: wrap; gap: 10px 32px; margin: 0 0 14px; }\n  .count { margin: 0; color: var(--muted); }\n  .count .n { display: block; font-size: 2.2em; font-weight: 600; line-height: 1.15; font-variant-numeric: tabular-nums; color: var(--text); }\n  /* The lit element: what waits on the reader, in the theme's warm colour. */\n  .count.lit .n { color: var(--warn); }\n  .asks { margin: 0; padding: 0; list-style: none; }\n  .asks li { position: relative; z-index: 0; padding: 6px 8px; border-top: 1px solid var(--border); overflow-wrap: anywhere; }\n  /* A new approval's envelope. The script moves --glow from 0 to 1 and back to 0. */\n  .asks li::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--warn-subtle); opacity: var(--glow, 0); }\n  .tool { color: var(--text-strong); font-weight: 600; }\n  .why { margin-left: 8px; color: var(--muted); }\n  .none { margin: 0; color: var(--muted); }\n  .notice { margin: 0; padding: 8px 10px; border-left: 2px solid var(--warn); background: var(--warn-subtle); color: var(--text); }\n</style>\n<script>\n// Adapted from anatomy by Ryan (MIT License): see living-ui/LICENSE-anatomy.md.\nvar LivingUI = LivingUI || {};\n// One requestAnimationFrame loop for a stage, the figure's root element.\n// tick(dt, calm) runs each frame and returns true while anything moves. dt is\n// in seconds, 1/60 on the first frame after a wake and never over 1/30, and\n// calm is true under prefers-reduced-motion, following its change event. The\n// loop sleeps when tick returns false or the stage is offscreen; kick() wakes\n// it after an input or a data change, and stop() ends it for good.\nLivingUI.loop = (stage, tick) => {\n  const reduce = matchMedia('(prefers-reduced-motion: reduce)');\n  let frame = 0, last = -1, inView = false, ended = false;\n  const step = (now) => {\n    const dt = last < 0 ? 1 / 60 : Math.min((now - last) / 1000, 1 / 30);\n    last = now;\n    frame = 0;\n    const moving = tick(dt, reduce.matches);\n    if (moving && inView && !ended && !frame) frame = requestAnimationFrame(step);\n  };\n  const kick = () => {\n    if (frame || !inView || ended) return;\n    last = -1;\n    frame = requestAnimationFrame(step);\n  };\n  // One callback can carry several entries for the stage, oldest first, so\n  // only the newest one says whether the stage is in view now.\n  const view = new IntersectionObserver((entries) => {\n    inView = entries[entries.length - 1].isIntersecting;\n    if (inView) return kick();\n    cancelAnimationFrame(frame);\n    frame = 0;\n  }, { rootMargin: '120px 0px' });\n  view.observe(stage);\n  reduce.addEventListener('change', kick);\n  return {\n    kick,\n    stop() {\n      ended = true;\n      cancelAnimationFrame(frame);\n      view.disconnect();\n      reduce.removeEventListener('change', kick);\n    },\n    get calm() { return reduce.matches; },\n  };\n};\n// Adapted from anatomy by Ryan (MIT License): see living-ui/LICENSE-anatomy.md.\nvar LivingUI = LivingUI || {};\n// Exponential follow. Each frame x covers 1 - e^(-dt / tau) of its gap to\n// target, so it slows as it arrives and moves the same at any frame rate.\n// tau is in seconds; 0.1 to 0.3 feels right. Returns the new x, which is\n// exactly target under calm or once it is within 0.0005, so x === target\n// means it has arrived.\nLivingUI.follow = (x, target, dt, tau = 0.2, calm = false) => {\n  const next = target + (x - target) * Math.exp(-dt / tau);\n  return calm || Math.abs(target - next) < 5e-4 ? target : next;\n};\n// Adapted from anatomy by Ryan (MIT License): see living-ui/LICENSE-anatomy.md.\nvar LivingUI = LivingUI || {};\n// The envelope of a one-shot event, such as an approval arriving or a run\n// failing, read from the event's age in seconds. It is 0 before the event,\n// rises over `rise` seconds from a flat start to 1, then fades with time\n// constant `fall`. Once faded under 0.001 it returns exactly 0, so a value\n// above 0 means the event still shows. Under calm, use 0 instead.\nLivingUI.burst = (age, rise = 0.08, fall = 0.13) => {\n  if (!(age > 0)) return 0;\n  const t = Math.min(1, age / rise);\n  const level = t * t * (3 - 2 * t) * Math.exp(Math.min(0, rise - age) / fall);\n  return age > rise && level < 1e-3 ? 0 : level;\n};\n(() => {\n  const stage = document.getElementById('approvals');\n  const waiting = document.getElementById('waiting');\n  const asks = document.getElementById('asks');\n  const none = document.getElementById('none');\n  // One model. Each count keeps the value it shows (x) and the value it is\n  // moving to (target). x is null while there is no count to show, and then\n  // the host's own text in the cell stands.\n  const counts = ['pending', 'requested', 'decided'].map((name) => ({\n    name,\n    cell: document.getElementById(name),\n    x: null,\n    target: null,\n  }));\n  // Each newly arrived approval's age in seconds, by id, while its envelope shows.\n  const glows = new Map();\n  // Each listed approval's row, by id, rebuilt from every list that arrives.\n  let rows = new Map();\n  // The ids in the last list, or null until a first list has arrived.\n  let seen = null;\n\n  const show = (count) => {\n    if (count.x === null) return;\n    const text = String(Math.round(count.x));\n    if (count.cell.textContent !== text) count.cell.textContent = text;\n  };\n\n  const run = LivingUI.loop(stage, (dt, calm) => {\n    let moving = false;\n    for (const count of counts) {\n      if (count.x === null) continue;\n      count.x = LivingUI.follow(count.x, count.target, dt, 0.3, calm);\n      // A count is shown as a whole number, so it has arrived once it rounds\n      // to its target. Landing it there lets the loop sleep on that frame.\n      if (Math.round(count.x) === count.target) count.x = count.target;\n      show(count);\n      if (count.x !== count.target) moving = true;\n    }\n    for (const [id, age] of glows) {\n      const level = calm ? 0 : LivingUI.burst(age + dt);\n      const row = rows.get(id);\n      if (row) row.style.setProperty('--glow', String(level));\n      if (level > 0) {\n        glows.set(id, age + dt);\n        moving = true;\n      } else {\n        glows.delete(id);\n      }\n    }\n    return moving;\n  });\n\n  for (const count of counts) {\n    window.kirocrew.subscribe(count.name, (value) => {\n      if (typeof value !== 'number' || !Number.isFinite(value)) {\n        // Not a count, such as null: the host's text stands, and the next\n        // count is shown where it is rather than moved to.\n        count.x = null;\n        count.target = null;\n        return;\n      }\n      // The first count is shown where it is, and under reduced motion every\n      // count is. Only a change moves.\n      if (count.x === null || run.calm) count.x = value;\n      count.target = value;\n      run.kick();\n    });\n  }\n\n  window.kirocrew.subscribe('pending_requests', (list) => {\n    if (!Array.isArray(list)) {\n      // No list to read: show no list rather than \"Nothing right now\". The last\n      // list's ids are kept, so the next list is still compared with them.\n      waiting.hidden = true;\n      return;\n    }\n    const drawn = new Map();\n    let shown = 0;\n    asks.textContent = '';\n    for (const ask of list) {\n      if (!ask || typeof ask !== 'object') continue;\n      const row = document.createElement('li');\n      const tool = document.createElement('span');\n      tool.className = 'tool';\n      tool.textContent = typeof ask.tool === 'string' && ask.tool ? ask.tool : 'a tool';\n      row.appendChild(tool);\n      if (typeof ask.reason === 'string' && ask.reason) {\n        const why = document.createElement('span');\n        why.className = 'why';\n        why.textContent = ask.reason;\n        row.appendChild(why);\n      }\n      asks.appendChild(row);\n      shown += 1;\n      const id = typeof ask.approval_id === 'string' ? ask.approval_id : '';\n      if (!id) continue;\n      drawn.set(id, row);\n      // New means absent from the last list. So the first list, the same list\n      // sent again and a list that lost a row start no envelope.\n      if (seen && !seen.has(id)) glows.set(id, 0);\n    }\n    rows = drawn;\n    seen = new Set(drawn.keys());\n    none.hidden = shown > 0;\n    waiting.hidden = false;\n    run.kick();\n  });\n\n  // The host writes every bound cell again on each push, a count that is still\n  // moving included, so the shown value goes back before the next paint.\n  window.addEventListener('kirocrew-dashboard', () => counts.forEach(show));\n})();\n</script>\n"
  }
}
