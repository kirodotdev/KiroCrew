{
  "name": "design-tweak",
  "version": "0.10.0",
  "displayName": "Design Tweak",
  "iconUrl": "/app-assets/design-tweak/icon.svg",
  "description": "Visually select elements in your live app preview and turn them into scoped, source-mapped edit requests for the agent — like Figma comments, but for code.",
  "author": "mxiaomen",
  "license": "MIT",
  "tags": [
    "design",
    "frontend",
    "preview",
    "visual-editing",
    "productivity"
  ],
  "defaultEnabled": false,
  "minKiroCrewVersion": "0.1.0",
  "skills": [
    "skills/visual-edit"
  ],
  "permissions": {
    "api": [
      "/apps/design-tweak/api",
      "/apps/design-tweak/api/*"
    ],
    "storage": true
  },
  "ui": {
    "pages": [
      {
        "route": "/design-tweak",
        "label": "Design Tweak",
        "icon": "Paintbrush"
      }
    ]
  },
  "backend": {
    "entryPoint": "kiro_crew.apps.builtins.design_tweak.backend.server",
    "port": "auto",
    "healthCheck": "/health"
  },
  "platform": {
    "os": [
      "macos",
      "linux"
    ]
  },
  "useCases": [
    "Annotate live UI elements in context and send a source-mapped batch of visual changes to a coding agent."
  ],
  "configuration": [
    "Load a local web project, start its detected dev server or enter an existing URL, switch to Edit mode, right-click elements, then send the batch."
  ],
  "screenshots": [
    "/app-assets/design-tweak/screenshot-main.png"
  ],
  "heroImage": "/app-assets/design-tweak/hero-light.svg",
  "heroImageDark": "/app-assets/design-tweak/hero-dark.svg",
  "heroImageDetail": "/app-assets/design-tweak/hero-detail-light.svg",
  "heroImageDetailDark": "/app-assets/design-tweak/hero-detail-dark.svg"
}
