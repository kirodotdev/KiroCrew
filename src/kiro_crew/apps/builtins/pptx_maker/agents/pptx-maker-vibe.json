{
  "name": "pptx-maker-vibe",
  "description": "Fast presentation agent. Turns source material (a URL, pasted text, a short brief) into slides with minimal questions, then delegates composition to pptx-maker-composer.",
  "mcpServers": {
    "sdpm": {
      "command": "{UV_BIN}",
      "args": ["run", "--directory", "{ENGINE_MCP_DIR}", "python", "server_acp.py"],
      "env": { "PYTHONPATH": "" },
      "timeout": 120000
    }
  },
  "prompt": "file://{ENGINE_ROOT}/mcp-local/acp-agent-prompts/vibe-agent.md",
  "resources": [
    "file://{ENGINE_ROOT}/skill/references/workflows/create-new-1-briefing.md",
    "file://{ENGINE_ROOT}/skill/references/workflows/create-new-1-outline.md",
    "file://{ENGINE_ROOT}/skill/references/workflows/create-new-1-art-direction.md",
    "file://{APP_PROMPTS}/spec-studio.md"
  ],
  "tools": [
    "@sdpm/analyze_template", "@sdpm/apply_style", "@sdpm/code_to_slide",
    "@sdpm/generate_pptx", "@sdpm/grid", "@sdpm/import_attachment",
    "@sdpm/init_presentation", "@sdpm/list_asset_sources", "@sdpm/list_guides",
    "@sdpm/list_styles", "@sdpm/list_templates", "@sdpm/list_workflows",
    "@sdpm/measure_slides", "@sdpm/pptx_to_json", "@sdpm/read_examples",
    "@sdpm/read_guides", "@sdpm/read_workflows", "@sdpm/run_python",
    "@sdpm/search_assets", "use_subagent", "read", "glob", "grep",
    "web_search", "web_fetch"
  ],
  "toolsSettings": {
    "subagent": {
      "availableAgents": ["pptx-maker-composer"],
      "trustedAgents": ["pptx-maker-composer"]
    }
  },
  "welcomeMessage": "Drop a URL, paste some text, or describe what you want — I'll turn it into slides.",
  "model": "auto"
}
