{
  "name": "file-explorer",
  "version": "1.0.0",
  "displayName": "Files",
  "description": "Multi-tab file explorer with tree navigation, syntax highlighting, markdown preview, search, and git status.",
  "author": "kirocrew",
  "tags": [
    "files",
    "explorer",
    "productivity",
    "code",
    "markdown"
  ],
  "defaultEnabled": false,
  "permissions": {
    "api": [
      "/apps/file-explorer/api"
    ]
  },
  "ui": {
    "pages": [
      {
        "route": "/file-explorer",
        "label": "Files",
        "icon": "FolderTree"
      }
    ]
  },
  "backend": {
    "entryPoint": "kiro_crew.apps.builtins.file_explorer.server",
    "port": "auto",
    "healthCheck": "/health"
  },
  "iconUrl": "/app-assets/file-explorer/icon.svg",
  "heroImage": "/app-assets/file-explorer/hero-light.svg",
  "heroImageDark": "/app-assets/file-explorer/hero-dark.svg"
}
