 src/kiro_crew/dashboard/handlers/mcp.py | 274 ++++++++++++++++++++----
 src/kiro_crew/mcp_discovery.py          | 138 +++++++++++-
 test/test_mcp_discovery_jsonc.py        | 165 ++++++++++++++
 test/test_mcp_sync_agent.py             | 115 ++++++++++
 5 files changed, 667 insertions(+), 40 deletions(-)
 create mode 100644 test/test_mcp_discovery_jsonc.py

