# Pinned AWS CLI v2 and Session Manager plugin for cloud-install.sh and
# install.ps1. Plain KEY=VALUE lines: sourced by sh, parsed by PowerShell.
#
# Each installer downloads the versioned artifact, checks it against the sha256
# here and installs nothing on a mismatch. AWS publishes no .sha256 files, so
# these were computed from two separate downloads that matched. The Linux AWS
# CLI hashes are the same ones the crew runtime Dockerfile pins
# (src/kiro_crew/apps/builtins/aws_control/crew/runtime/Dockerfile); keep
# AWSCLI_VERSION equal to its ARG AWSCLI_VERSION (test/test_installer_tool_pins.py
# checks this).
#
# To bump (reviewed on every release, docs/build/release.md): pick the new
# version, download each artifact twice, record the matching sha256, update
# the Dockerfile in the same change, and run test/test_installer_tool_pins.py.
# A stale pin only means an older tool; versioned artifacts stay downloadable.

AWSCLI_VERSION=2.34.0
AWSCLI_SHA256_LINUX_X86_64=f7137e1c4d6d5cae31fbdcfd1fe03784b71e46aead36ba046674a694e1623aa6
AWSCLI_SHA256_LINUX_AARCH64=d1abb2e8fcbc9e7ac3b6acf92bf886af67dfb4d30d77b766cc8a56bd00009aeb
AWSCLI_SHA256_MACOS_PKG=b441d20bd8f41bf69baaeb70225a0c97722ab0ee17fef0dcc76da03a814411d0
AWSCLI_SHA256_WINDOWS_MSI=54416cad7570c97769f81d991d7b7acdb7e2c10d7d7ba987530ee1d0a5da17b6

SSM_PLUGIN_VERSION=1.2.896.0
SSM_SHA256_MAC=d9d960f04acb5ba419e0a12f769f9af4f3263e098b9b63e2de659189c138341a
SSM_SHA256_MAC_ARM64=b95139a76cb473654d92185c200ac65205244b20f96aeb240b53837ba4973084
SSM_SHA256_LINUX_64BIT_RPM=89a4a07fcb92169bdd2f07c2531acd11b84857338172e7638964aaa08fd5f0e3
SSM_SHA256_LINUX_ARM64_RPM=edb766755393202e1193f8d2578c356a5ce409182e618b302da4e9c253d05895
SSM_SHA256_UBUNTU_64BIT_DEB=53f51fcc67314a4bf85888a38a3967cd41f8d0f28a60a9469a63acf935ba713e
SSM_SHA256_UBUNTU_ARM64_DEB=914eeca87b18b55356c58be197080f73742b3ca60d3823f0a45670dc9056aa9c
SSM_SHA256_WINDOWS_EXE=116a121ca6a781b7985d0c9fa3c5c9143440acde7822de2e32733665eed30347
