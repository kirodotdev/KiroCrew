{
  "name": "agent-worlds",
  "version": "0.1.0",
  "displayName": "Agent Worlds",
  "description": "Pixel art visualization of your agents at work — standalone federated app",
  "author": "kirocrew",
  "tags": ["visualization", "agents", "pixel-art", "fun"],
  "ui": {
    "entry": "index.mjs",
    "pages": [
      {
        "route": "/apps/agent-worlds",
        "label": "Agent Worlds",
        "icon": "Gamepad2",
