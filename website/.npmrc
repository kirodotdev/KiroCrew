# No registry pin here on purpose: the npm registry is system-configured
# (user/global .npmrc or environment), so mirrors and private registries work
# for builders who cannot reach https://registry.npmjs.org/.

# Wait before resolving newly published package versions: freshly released
# packages are the main vector for supply-chain attacks and broken releases.
min-release-age=7

# Pin the V8 heap for every npm script instead of inheriting Node's default,
# which is sized from the HOST's RAM. That made the bundle's memory headroom a
# property of the machine: a 123 GB dev box gets a ~4 GB heap and builds fine,
# while the macos-14 CI runner gets ~2 GB and died with "Ineffective
# mark-compacts near heap limit" the moment the tenth i18n catalog landed (peak
# 1965 MB against a 2054 MB ceiling).
#
# Set here rather than as an inline `NODE_OPTIONS=... npm run build` prefix
# because CI builds the frontend from six workflows plus Makefile, setup.py and
# packaging/build-desktop.sh — and one of those runners is Windows, where a shell
# variable prefix is not portable and `cross-env` is not a dependency. npm passes
# this to every script on every platform, so there is one place to change.
#
# This is a ceiling, not a target: raise it only for real bundle growth.
node-options=--max-old-space-size=6144
