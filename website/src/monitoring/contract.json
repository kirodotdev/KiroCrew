      "no_change",
      "record_only",
      "wake_actionable",
      "stop_success",
      "stop_blocked",
      "retry_provider",
      "stop_budget"
    ],
    "lastProviderError": [
      "transient",
      "rate_limited",
      "authentication",
      "authorization",
      "not_found",
      "setup"
    ],
    "lastObservationStatus": ["pending", "actionable", "success", "blocked", "provider_error"],
    "outcome": ["success", "blocked", "budget", "user_stop", "session_close", "target_unavailable"]
