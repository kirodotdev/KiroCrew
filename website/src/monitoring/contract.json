{
  "monitorStateVersion": 1,
  "limits": {
    "cadenceSecs": { "minimum": 15, "maximum": 86400, "defaultValue": 300 },
    "maxRuntimeSecs": { "minimum": 1, "maximum": 604800, "defaultValue": 14400 },
    "maxAgentTurns": { "minimum": 1, "maximum": 8, "defaultValue": 8 },
    "maxTokens": { "minimum": 1, "maximum": 1000000, "defaultValue": 250000 },
    "maxProviderErrors": { "minimum": 1, "maximum": 20, "defaultValue": 3 },
    "wakeInstructions": { "maximumLength": 1000 }
  },
  "pullRequestMonitorKinds": ["github_pull_request"],
