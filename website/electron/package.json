{
  "name": "kirocrew-electron-mac",
  "version": "0.1.2",
  "description": "Kiro Crew \u2014 AI agent desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.0"
  },
  "build": {
    "appId": "com.amazon.kiro.crew",
    "productName": "KiroCrew",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "x64ArchFiles": "{**/backend-dist/**,**/backend-dist/**/.*/**}",
      "extendInfo": {
        "CFBundleDisplayName": "Kiro Crew",
        "NSMicrophoneUsageDescription": "Kiro Crew uses the microphone for voice input and dictation in chat. Audio is captured only while you hold or toggle the mic button."
      }
    },
    "afterSign": "scripts/notarize.js",
    "linux": {
      "category": "Development",
      "icon": "icon.png",
      "target": [
        "AppImage"
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "files": [
      "main.js",
      "app-menu.js",
      "badge.js",
      "native-theme.js",
      "zoom.js",
      "instance-guard.js",
      "context-menu.js",
      "find-bin.js",
      "data-home.js",
      "auto-update.js",
      "bundle-location.js",
      "gateway-auth-hint.js",
      "gateway-stop.js",
      "gateway-wait.js",
      "home-dir.js",
      "local-token.js",
      "window-state.js",
      "gateway-liveness.js",
      "gateway-recovery.js",
      "pyspy-dump.js",
      "perf-metrics.js",
      "host-config.js",
      "remote-token.js",
      "token-retry.js",
      "display-media.js",
      "permission-handler.js",
      "external-scheme.js",
      "validation.js",
      "context-menu.js",
      "preload.js",
      "anime.global.js",
      "loading.html",
      "token-prompt.html",
      "icon.png",
      "icon-nightly.png"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend-dist",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.crew.kiro.dev/feed/stable/"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "squirrel"
      ],
      "signtoolOptions": {
        "sign": "./scripts/sign-windows.js"
      }
    },
    "squirrelWindows": {
      "name": "KiroCrew",
      "iconUrl": "https://raw.githubusercontent.com/kirodotdev/KiroCrew/main/website/electron/icon.ico"
    }
  },
  "author": "Kiro Crew"
}
