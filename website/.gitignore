node_modules
dist
build
coverage
*.tsbuildinfo
.vite

# The DEV-mode bundle the i18n render gate builds (scripts/check-i18n-render.mjs).
# A separate output dir on purpose: it is NOT shippable — `import.meta.env.DEV` is
# true, so it carries the en-XA pseudolocale catalog and dev-only tooling. The bare
# `dist` rule above does not cover it.
dist-dev

# Electron
electron/dist
electron/node_modules
# …but the electron-builder resources dir is committed source, not an artifact
# (the bare `build` rule above would otherwise ignore it).
!electron/build
!electron/build/**

# TUI
tui/dist
tui/node_modules

# Playwright auth (generated by auth.setup.ts, must never be committed)
auth.json
playwright/.auth/
test-results/
playwright-report/
screenshot-cli.mjs

# MacOS
.DS_Store
