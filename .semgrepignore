# A .semgrepignore file REPLACES semgrep's built-in defaults, so replicate
# them first (.git + honor .gitignore), then add repo-specific entries.
.git/
:include .gitignore

# Vendored third-party code (llama-cpp-python, MIT) — upstream source we must
# not modify; carries its own urllib use in optional multimodal helpers that
# KiroCrew never calls. Mirrors the .woke.yml and lint excludes for _vendor.
src/kiro_crew/_vendor/

# Deliberately-vulnerable fixtures for the custom rules in semgrep/. They are
# exercised ONLY by the `semgrep --test` harness step (which targets the
# directory explicitly and is not subject to this file); the normal scan must
# never read them, or the fixtures themselves would fail the SAST job.
semgrep-tests/
